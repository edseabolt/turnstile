direction: down

fresh: "Fresh (per prompt)" {
  shape: oval
}
planning: "Planning" {
  shape: oval
}
planok: "Plan approved" {
  shape: oval
}
executor: "Executor done\n(cites chunk-N / AC-n)" {
  shape: oval
}
green: "Tests green" {
  shape: oval
}
reviewed: "Review approved" {
  shape: oval
}
end: "next user prompt (new task)" {
  shape: circle
}

start: "user prompt admitted\n(resetState + carry)" {
  shape: circle
}

dormant: "Dormant (engaged: no)\nreactive gates sleep;\ndenylists + telemetry run" {
  shape: oval
  style.stroke: "#c33"
}
engaged: "Engaged (engaged: yes)\nfull gate chain armed" {
  shape: oval
}

start -> dormant: "fresh bucket (default)"
dormant -> engaged: "PLAN APPROVED: | plan-ref /\ndispatch prompt | planner dispatch\n(journaled engagement row)"
engaged -> dormant: "task retire | TURNSTILE OFF: |\nno-credit new prompt\n(journaled engagement row)"
engaged -> engaged: "continuation carry keeps it\n(replay restores last-wins)" {
  style.stroke-dash: 4
}

start -> fresh
fresh -> planning: "planner dispatch\ncap 3, budget 16 total"
planning -> planok: "plan-reviewer APPROVE | PLAN APPROVED: | permission 'always'"
planning -> planning: "BLOCK → revise → re-review\n(round-scoped attribution)\n[observe period: suppressed —\nwould-block journaled, the call\nproceeds metered]" {
  style.stroke-dash: 4
}
planok -> executor: "executor dispatch\n(## Decomposition in plans dir,\nonce-shot 'once' grant releases one)"
executor -> green: "test-runner GATE: PASS\n(verified by exit-0 evidence when gateEvidence=enforce)"
green -> planok: "GATE: FAIL (latest-wins)" {
  style.stroke-dash: 4
}
green -> reviewed: "reviewer APPROVE ×2 (reviewEnsemble=enforce) | permission landing 'always'"
reviewed -> reviewed: "git push allowed"
green -> end: "next prompt: review credited or no reviewer dispatch yet"
green -> green: "next prompt with an interrupted\nreview (green gate, dispatches ≥ 1\nor a waived round, no credited\napproval) — recovery carry" {
  style.stroke-dash: 4
}

suspend: "Suspended\n(TURNSTILE OFF:)\ndecisions computed + journaled,\nno BLOCKED, no permission ask" {
  shape: oval
  style.stroke: "#c33"
}
suspend -> suspend: "would-block + suppressed\naudit entries journaled" {
  style.stroke-dash: 4
}
start -> suspend: "TURNSTILE OFF: in the user prompt\n(clearState fresh; survives restart via replay)"
suspend -> start: "TURNSTILE ON: (fresh start again)"
refused-note: "allowSuspend:false refuses OFF and ON markers\n(journaled refused:true + surfaced diagnostic;\nno state change)." {
  style.stroke-dash: 4
  shape: parallelogram
}
refused-note -> suspend: "" {
  style.opacity: 0
}

planok-note: "bound approval (dispatch-named plan):\nname + per-file key;\nbound-plan edit/removal ⇒ plan-edited / plan-missing STALE;\nunbound approval: path-free plansSignature;\nplans-dir change ⇒ signature-mismatch STALE ⇒ re-review." {
  style.stroke-dash: 4
  shape: parallelogram
}
reviewed-note: "pendingOnceGrant.landing releases exactly one push.\nemptyDiffExempt: a push whose every refspec is ref-equal\nto its upstream is allowed without approval\n(no force flags; journaled exempt:empty-diff)."
handson-note: "hands-on gate (parent write/edit only):\ntask-scoped handsOnBlocks arms the ask on a repeat\nunder escalation:\"ask\"; escalation:\"block\" (default)\nre-blocks the repeat — no ask, no latch — release via\nUSER WAIVER: or an earned reviewer verdict only;\nhandsOnRelease (permission 'always') or an executor-\nscoped USER WAIVER: releases; pendingOnceGrant.handsOn\nreleases exactly one edit. Plan approval does not release.\nhandsOnBlocks and pendingOnceGrant.handsOn are prompt-reset\nand dropped by mergeAfterReplay (a restart re-arms —\nfail-toward-strict); handsOnRelease is restart-sticky\n(carried through mergeAfterReplay and restored by replay)." {
  style.stroke-dash: 4
  shape: parallelogram
}
planok-note -> planok: "" {
  style.opacity: 0
}
reviewed-note -> reviewed: "" {
  style.opacity: 0
}
handson-note -> green: "" {
  style.opacity: 0
}