direction: right

# Module map: curated view — key boundaries plus the setup wiring spine.
# Not every import edge is drawn: type-only imports are labeled as such,
# and some cross-boundary value imports are omitted for readability.

host: "OpenCode host\n(v2 promise-plugin API)" {
  session-hook: "session.hook\nprompt · generate · compaction"
  tool-hook: "tool.hook\nexecute.before · execute.after"
  event-sub: "event.subscribe\n(stream loop)"
  perm-hook: "permission.hook('evaluate')"
  app-version: "app.version"
}

entry: "turnstile.ts\n{ id:'turnstile', server, setup }\nthin factory — contracts in doc comment"

core: "src/ — one concern per boundary" {
  setup: "setup.ts\nwiring only: hook registration, heartbeat,\nlifecycle/disposal"
  hostcompat: "host-compat.ts\nhost version guard: semver parse/compare,\nshipped range, verdict"
  hookscore: "hooks-core.ts\nshared hook state + services:\nTurnstileContext (config, journaler, gates,\nledger, admission, marker parsing,\nverdict attribution)"
  hookssession: "hooks-session.ts\nprompt · generate · compaction bodies"
  hookspermission: "hooks-permission.ts\nevaluate body (plan/landing arms)"
  hookstool: "hooks-tool.ts\nexecute.before / after bodies"
  hooksevents: "hooks-events.ts\nevent surface: consume + supervise\n(throw-only restart budget)"
  delivery: "delivery.ts\nhost payload delivery: shape ladder,\ntext mutation, key tables, ask prefixes"
  config: "config.ts\n4-layer config (defaults ⊕ file ⊕ env ⊕ opts),\nvalidation, configDigest"
  state: "state.ts — GateState shape\nnewState, counters, snapshot + pipeline\nrendering, replay-merge"
  ledger: "ledger.ts — GateLedger\nbuckets (LRU), child→parent edges,\nverdict store, journal replay"
  markers: "markers.ts\npure GATE:/VERDICT: parsing, dedup, suppression"
  childreg: "child-registration.ts\npipeline-child resolution: agent-name\nprecedence, edge + emitter fallback,\nfail-closed unknown"
  gates: "gates.ts\ncomposition: createGates + the Gates interface"
  gatesdispatch: "gates-dispatch.ts\nreviewer gate, loop caps, read horizon,\nensemble completeness"
  gatesplan: "gates-plan.ts\nplan-approval gate, decomposition gate,\nplans-dir scan + cache (spec-region keys)"
  planregion: "plan-region.ts\nplanSpecRegion: spec-slice extractor —\nProgress section excluded from the\nhashed approval key"
  maintenance: "maintenance.ts\nmaintenance-dispatch rules: declaration,\nnon-src diff eligibility, marker guard"
  gatescommon: "gates-common.ts\nBlockError + waiver coverage semantics"
  toolpolicy: "tool-policy.ts\nbash denylist, commit lint, landing gate,\nhands-on gate (write/edit + bash write)"
  bashwrite: "bash-write.ts\nwrite-shape classifier (classifyBashWrite)\n+ shell tokenizer (splitCommands/tokenizeWords)"
  emptydiff: "empty-diff.ts\nempty-diff probe: planPushRefs (static)\n+ ref-equality check (exec seam)"
  evidence: "evidence.ts\ncorrelates GATE: PASS with exit-0 test executions"
  fingerprint: "fingerprint.ts\nworktree fingerprint, continuation-carry predicate"
  bounded: "bounded.ts\nbounded-map FIFO eviction"
  journal: "journal.ts\nturnstile.jsonl + trace, rotation, fail-open appends,\nfail-open journal reader (readJournalEntries)"
  summary: "summary.ts\nsession-end summary counting + one-line\nformatting over parsed entries (pure)"
  policy: "policy.ts\norchestratorPolicyFor prose\nbuilt from resolved config"
  scratch: "scratch.ts\nisScratchTarget: temp-dir write/edit\nexemption predicate (zero-governance)"
  intent: "intent.ts\nclassifyIntent: implementation-intent\nsignals vs deliberate non-intent"
  generateinjection: "generate-injection.ts\nrequest-draft primitives: usableRequestDraft,\nappendSystemText, describeRequestDraft"
  taskscope: "task-scope.ts\nkeepsTaskScope, isInterruptedReview,\napprovalResetsScope (pure predicates)"
  types: "types.ts\nhost wire shapes, GateState, TurnstileConfig"
}

persist: "~/.local/share/opencode/metrics/" {
  jsonl: "turnstile.jsonl\naudit trail, always-on" {
    shape: cylinder
  }
  trace: "gate-events.log\ntrace, only when trace:true" {
    shape: cylinder
  }
}

host.session-hook -> entry
host.tool-hook -> entry
host.event-sub -> entry
host.perm-hook -> entry
entry -> core.setup
host -> core.setup: "app.version"
core.setup -> core.hostcompat
core.setup -> core.hookscore
core.setup -> core.hookssession
core.setup -> core.hookspermission
core.setup -> core.hookstool
core.setup -> core.hooksevents
core.setup -> core.config
core.setup -> core.gates
core.hookscore -> core.config
core.hookscore -> core.journal
core.hookscore -> core.gates
core.hookscore -> core.gatescommon
core.hookscore -> core.evidence
core.hookscore -> core.toolpolicy
  core.hookscore -> core.bashwrite
core.hookscore -> core.emptydiff
core.toolpolicy -> core.emptydiff
  core.toolpolicy -> core.bashwrite
core.hookscore -> core.state
core.hookscore -> core.ledger
core.hookscore -> core.markers
core.hookscore -> core.childreg
core.hookstool -> core.childreg
core.hookscore -> core.fingerprint
core.hookscore -> core.delivery
core.hookscore -> core.bounded
core.hooksevents -> core.summary
core.summary -> core.journal: "type-only"
core.hookssession -> core.hookscore: "type-only"
core.hookssession -> core.delivery
core.hookssession -> core.state
core.hookspermission -> core.hookscore: "type-only"
core.hookspermission -> core.delivery
core.hookspermission -> core.toolpolicy
core.hookstool -> core.hookscore: "type-only"
core.childreg -> core.markers
core.childreg -> core.ledger: "type-only"
core.childreg -> core.types: "type-only"
core.hookstool -> core.delivery
core.hooksevents -> core.hookscore: "type-only"
core.hooksevents -> core.delivery
core.hookscore -> core.policy
core.hookscore -> core.maintenance
core.hookscore -> core.scratch
core.hookscore -> core.intent
core.hookscore -> core.generateinjection
core.state -> core.taskscope
core.fingerprint -> core.taskscope
core.gatesplan -> core.planregion
core.ledger -> core.journal: "replay (fs)"
core.ledger -> core.state: "newState, counters, merge"
core.ledger -> core.bounded
core.evidence -> core.bounded
core.journal -> persist.jsonl
core.journal -> persist.trace
core.gates -> core.gatesdispatch
core.gates -> core.gatesplan
core.gates -> core.ledger: "type-only"
core.gates -> core.journal: "type-only"
core.gates -> core.types: "type-only"
core.gatesdispatch -> core.gatescommon
core.gatesdispatch -> core.state: "REVIEW_ENSEMBLE_SIZE"
core.gatesdispatch -> core.ledger: "type-only"
core.gatesdispatch -> core.journal: "type-only"
core.gatesdispatch -> core.types: "type-only"
core.gatesplan -> core.gatescommon
core.gatesplan -> core.ledger: "type-only"
core.gatesplan -> core.journal: "type-only"
core.gatesplan -> core.types: "type-only"
core.gatescommon -> core.types: "type-only"
core.toolpolicy -> core.types
core.config -> core.types
