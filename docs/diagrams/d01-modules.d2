direction: right

# Module map: curated view — key boundaries plus the setup wiring spine.
# Edges are direct imports or ctx-bound calls (e.g. hooks-core via ctx); not
# every one is drawn: type-only imports are labeled as such, and some
# cross-boundary value imports are omitted for readability.

host: "OpenCode host\n(v2 promise-plugin API)" {
  session-hook: "session.hook\nprompt · generate · context · compaction"
  tool-hook: "tool.hook\nexecute.before · execute.after"
  event-sub: "event.subscribe\n(stream loop)"
  perm-hook: "permission.hook('evaluate')"
  app-version: "app.version"
}

entry: "turnstile.ts\n{ id:'turnstile', server, setup }\nthin factory — contracts in doc comment"

core: "src/ — one concern per boundary" {
  setup: "setup.ts\nwiring only: hook registration, heartbeat,\nlifecycle/disposal"
  hostcompat: "host-compat.ts\nhost version guard: semver parse/compare,\nshipped range, verdict"
  hookscore: "hooks-core.ts\ncomposition: CoreState builders + concern\nwiring + coreContext — no hook bodies"
  hookssession: "hooks-session.ts\nsession-surface registration (bodies in\nhooks-session-bodies.ts)"
  hookspermission: "hooks-permission.ts\npermission-surface registration\n(arms in permission-evaluate.ts)"
  hookstool: "hooks-tool.ts\ntool-surface registration (bodies in\ntool-hooks-before/after.ts)"
  hooksevents: "hooks-events.ts\nevent stream loop + supervision\n(handlers in event-stream-handlers.ts)"
  delivery: "delivery.ts\nhost payload delivery: shape ladder,\ntext mutation, key tables, ask prefixes"
  config: "config.ts\n4-layer config composition\n(merge in config-merge.ts, validation in\nconfig-validate.ts), configDigest"
  state: "state.ts — GateState shape\ncounters, snapshot + pipeline rendering\n(bucket/carry in state-carry.ts)"
  ledger: "ledger.ts — GateLedger\nbuckets (LRU), verdict store, journal replay\n(edges/registry in ledger-registry.ts)"
  markers: "markers.ts\nmarker regexes (canonical), dedup,\nsuppression (parse arms in\ngate-markers-parse.ts)"
  childreg: "child-registration.ts\npipeline-child resolution: agent-name\nprecedence, edge + emitter fallback,\nfail-closed unknown"
  gates: "gates.ts\ncomposition: createGates + the Gates interface"
  gatesdispatch: "gates-dispatch.ts\ncomposition (budget in dispatch-budget.ts,\nreview gate in dispatch-review-gate.ts,\nmessages in gate-messages.ts)"
  gatesplan: "gates-plan.ts\ncomposition (scan in plans-scan.ts,\nenforcement in plan-gate-enforce.ts,\nstatus mirror in plan-gate-status.ts)"
  planregion: "plan-region.ts\nplanSpecRegion: spec-slice extractor —\nProgress section excluded from the\nhashed approval key"
  maintenance: "maintenance.ts\nmaintenance-dispatch rules: declaration,\nnon-src diff eligibility, marker guard"
  gatescommon: "gates-common.ts\nBlockError + waiver coverage semantics"
  toolpolicy: "tool-policy.ts\ncomposition (guards + telemetry in\ntool-policy-guards.ts)"
  bashwrite: "bash-write.ts\nwrite-shape classifier (classifyBashWrite)\n(parser in shell-parse.ts)"
  emptydiff: "empty-diff.ts\nempty-diff probe: planPushRefs (static)\n+ ref-equality check (exec seam)"
  evidence: "evidence.ts\nevidence tracker factory (hits map in\nevidence-hits.ts)"
  fingerprint: "fingerprint.ts\nworktree fingerprint, continuation-carry predicate"
  bounded: "bounded.ts\nbounded-map FIFO eviction"
  journal: "journal.ts\njournaler factory + fail-open reader\n(sinks/rotation in journal-sinks.ts)"
  summary: "summary.ts\nsession-end summary counting + one-line\nformatting over parsed entries (pure)"
  policy: "policy.ts\norchestratorPolicyFor prose\nbuilt from resolved config"
  scratch: "scratch.ts\nisScratchTarget: temp-dir write/edit\nexemption predicate (zero-governance)"
  intent: "intent.ts\nclassifyIntent: implementation-intent\nsignals vs deliberate non-intent"
  generateinjection: "generate-injection.ts\nrequest-draft primitives: usableRequestDraft,\nappendSystemText, describeRequestDraft"
  taskscope: "task-scope.ts\nkeepsTaskScope, isInterruptedReview,\napprovalResetsScope (pure predicates)"
  // hooks-core concern modules (one per concern, state threaded via CoreState)
  contextsurface: "context-surface.ts\nonce-per-load injections: config warnings,\nobserve summary, draft telemetry,\ncontext policy head"
  parentresolution: "parent-resolution.ts\nparent edge + project dir resolution,\nemitter authority, boot re-seed"
  verdictcapture: "verdict-capture.ts\nmarker parsing + first-sight journaling,\nstreamed verdict recording, lastMatch"
  planverdict: "plan-verdict.ts\nplan-verdict attribution + approval\nbinding + durable plan identity"
  dispatchguard: "dispatch-guard.ts\ntask/subagent dispatch prologue +\nguard-and-meter chain + admit exit"
  bashwriteguard: "bash-write-guard.ts\nbash/shell + write/edit execute.before\nguards, telemetry, exemptions, ladders"
  promptadmission: "prompt-admission.ts\nprompt admission body, task-scope\nreset/carry, prompt-channel captures"
  hookssessionbodies: "hooks-session-bodies.ts\nsession-surface bodies: admission count,\ndecoding clamps, context body, compaction"
  permissionevaluate: "permission-evaluate.ts\nevaluate arms: plan-gate, landing-gate,\nhands-on-gate escalations"
  toolhooksbefore: "tool-hooks-before.ts\nexecute.before router: dispatch, read\nbudget, denylist guards, session_move"
  toolhooksafter: "tool-hooks-after.ts\nexecute.after body: surface blocks +\nper-tool delivery bodies"
  eventstreamhandlers: "event-stream-handlers.ts\nper-event dispatch table: edges, marker\nparsing, ask/reply bookkeeping, inbox"
  configmerge: "config-merge.ts\nper-section patch merging for mergeConfig"
  configvalidate: "config-validate.ts\nscalar patch validation + resolved\nconfig invariants"
  statecarry: "state-carry.ts\nnewState bucket factory + replay/\ncontinuation carry merge"
  ledgerregistry: "ledger-registry.ts\nchild→parent edge maps, live-parent\nregistry, credit-bearing APPROVE trace"
  gatemarkersparse: "gate-markers-parse.ts\nGATE/VERDICT parse arms (pure; caller\njournals the events)"
  evidencehits: "evidence-hits.ts\nhits-map ops behind the evidence tracker\n(record, correlate, snapshot, clear)"
  journalsinks: "journal-sinks.ts\nappend/rotate primitives, sink resolution,\nrotation locking, trace formatting"
  toolpolicyguards: "tool-policy-guards.ts\ndenylist guards, commit lint, landing +\nhands-on gates, telemetry observers"
  dispatchbudget: "dispatch-budget.ts\nper-leg loop caps, total-dispatch budget,\nread horizon"
  dispatchreviewgate: "dispatch-review-gate.ts\nreviewer round-cap + gate-evidence gate,\nwaiver consumption, ensemble credit"
  gatemessages: "gate-messages.ts\nshared cap-block + gate-unverified\nrefusal message composers"
  plansscan: "plans-scan.ts\ncached plans-dir scan: names, spec-region\nkeys, Decomposition set"
  plangateenforce: "plan-gate-enforce.ts\nplan-approval + decomposition enforcement"
  plangatestatus: "plan-gate-status.ts\nplan-gate status mirror, plan preview/\nsummary, scope resolution"
  shellparse: "shell-parse.ts\nquote-aware command splitter + word\ntokenizer + redirect scanner (pure)"
  commitargs: "commit-args.ts\ngit commit -m message extraction +\nuninspectable-form detection (pure)"
  engagement: "engagement.ts\nshouldEngage predicate + engagement\njournal entry builder (pure)"
  decisionledger: "decision-ledger.ts\nprov:* entry builders for human\nprompts/denials (config.decisionLedger)"
  decisionledgerredact: "decision-ledger-redact.ts\nredaction filter for the decision ledger"
  planscope: "plan-scope.ts\nplanScopeFiles + classifyPlanImpact\n(pure): advisory vs structural set,\nplan-impact classification — no fs"
  types: "types.ts\nhost wire shapes, GateState, TurnstileConfig"
}

persist: "~/.local/share/opencode/metrics/" {
  jsonl: "turnstile.jsonl\naudit trail, always-on" {
    shape: cylinder
  }
  trace: "gate-events.log\ntrace, only when trace:true" {
    shape: cylinder
  }
}

host.session-hook -> entry
host.tool-hook -> entry
host.event-sub -> entry
host.perm-hook -> entry
entry -> core.setup
host -> core.setup: "app.version"
core.setup -> core.hostcompat
core.setup -> core.hookscore
core.hookscore -> core.contextsurface
core.hookscore -> core.parentresolution
core.hookscore -> core.verdictcapture
core.hookscore -> core.planverdict
core.hookscore -> core.dispatchguard
core.hookscore -> core.bashwriteguard
core.hookscore -> core.promptadmission
core.contextsurface -> core.generateinjection
core.contextsurface -> core.policy
core.parentresolution -> core.childreg
core.verdictcapture -> core.gatemarkersparse
core.verdictcapture -> core.markers
core.planverdict -> core.plangatestatus
core.dispatchguard -> core.dispatchbudget
core.dispatchguard -> core.dispatchreviewgate
core.dispatchguard -> core.gatemessages
core.dispatchguard -> core.maintenance
core.dispatchguard -> core.childreg
core.bashwriteguard -> core.toolpolicy
core.bashwriteguard -> core.bashwrite
core.bashwriteguard -> core.scratch
core.bashwriteguard -> core.emptydiff
core.bashwriteguard -> core.planscope: "type-only"
core.promptadmission -> core.engagement
core.promptadmission -> core.fingerprint
core.promptadmission -> core.taskscope
core.hookssession -> core.hookssessionbodies
core.hookspermission -> core.permissionevaluate
core.hookstool -> core.toolhooksbefore
core.hookstool -> core.toolhooksafter
core.toolhooksbefore -> core.dispatchguard
core.toolhooksbefore -> core.bashwriteguard
core.toolhooksafter -> core.verdictcapture
core.hooksevents -> core.eventstreamhandlers
core.eventstreamhandlers -> core.verdictcapture
core.config -> core.configmerge
core.config -> core.configvalidate
core.state -> core.statecarry
core.ledger -> core.ledgerregistry
core.evidence -> core.evidencehits
core.journal -> core.journalsinks
core.toolpolicy -> core.toolpolicyguards
core.toolpolicyguards -> core.shellparse
core.toolpolicyguards -> core.commitargs
core.bashwrite -> core.shellparse
core.gatesdispatch -> core.dispatchbudget
core.gatesdispatch -> core.dispatchreviewgate
core.gatesdispatch -> core.gatemessages
core.gatesplan -> core.plansscan
core.gatesplan -> core.plangateenforce
core.gatesplan -> core.plangatestatus
core.plangateenforce -> core.plansscan
core.plangatestatus -> core.plansscan
core.plangatestatus -> core.planscope
core.gatesdispatch -> core.gatescommon
core.gatesplan -> core.gatescommon
core.setup -> core.hookssession
core.setup -> core.hookspermission
core.setup -> core.hookstool
core.setup -> core.hooksevents
core.setup -> core.config
core.setup -> core.gates
core.hookscore -> core.config
core.hookscore -> core.journal
core.hookscore -> core.gates
core.hookscore -> core.gatescommon
core.hookscore -> core.evidence
core.hookscore -> core.toolpolicy
  core.hookscore -> core.bashwrite
core.hookscore -> core.emptydiff
core.toolpolicy -> core.emptydiff
  core.toolpolicy -> core.bashwrite
core.hookscore -> core.state
core.hookscore -> core.ledger
core.hookscore -> core.markers
core.hookscore -> core.childreg
core.hookstool -> core.childreg
core.hookscore -> core.fingerprint
core.hookscore -> core.delivery
core.hookscore -> core.bounded
core.hooksevents -> core.summary
core.summary -> core.journal: "type-only"
core.hookssession -> core.hookscore: "type-only"
core.hookssession -> core.delivery
core.hookssession -> core.state
core.hookspermission -> core.hookscore: "type-only"
core.hookspermission -> core.delivery
core.hookspermission -> core.toolpolicy
core.hookstool -> core.hookscore: "type-only"
core.childreg -> core.markers
core.childreg -> core.ledger: "type-only"
core.childreg -> core.types: "type-only"
core.hookstool -> core.delivery
core.hooksevents -> core.hookscore: "type-only"
core.hooksevents -> core.delivery
core.hookscore -> core.policy
core.hookscore -> core.maintenance
core.hookscore -> core.scratch
core.hookscore -> core.intent
core.hookscore -> core.generateinjection
core.state -> core.taskscope
core.fingerprint -> core.taskscope
core.gatesplan -> core.planregion
core.ledger -> core.journal: "replay (fs)"
core.ledger -> core.state: "newState, counters, merge"
core.ledger -> core.bounded
core.promptadmission -> core.decisionledger
core.eventstreamhandlers -> core.decisionledger
core.decisionledger -> core.decisionledgerredact
core.evidence -> core.bounded
core.journal -> persist.jsonl
core.journal -> persist.trace
core.gates -> core.gatesdispatch
core.gates -> core.gatesplan
