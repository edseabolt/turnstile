direction: right

writers: "Writers" {
  hooks: "hooks & gates"
}

jsonl: "turnstile.jsonl\nshared fallback\n5 MB × 5 generations" {
  shape: cylinder
}
sessions: "sessions/<parentID>.jsonl\nper parent session\nsame bounds per file" {
  shape: cylinder
}
trace: "gate-events.log" {
  shape: cylinder
}
approval: "approved-plans.jsonl\nbound plan approvals\nname + content key + project scope\nscheme tag (spec; untagged = legacy)\n256 cap, rewrite on eviction" {
  shape: cylinder
}

replay: "replayGatePasses\nrestores hasGatePass, hasPlanVerdict\n(+ plansSignature), hasReviewApprove,\nensemble counts, observe period,\ngate suspension (action:off|on,\nlast-wins)\n→ replayGrace = one-prompt survival"
ledger: "GateLedger in memory"
enforce: "execute.before guards"
cli: "opencode-turnstile status\n(read-only aggregation)"
chain: "hash chain (tamperEvidence.enabled)\nhash = sha256(canonical(\n  prevHash + ts + payload))\nper row: seq, prevHash, hash"
epoch: "chain-epoch rows\nper epochEntries (512):\nMerkle root + head\nover the epoch's data rows"
anchors: "anchors.jsonl\npublished epoch refs\n(session-state sink)" {
  shape: cylinder
}
sinks: "anchor sinks\nsession-state (host)\ngit-note / commit-trailer (repo)\n{plugin} (external)"
verify: "verifyJournalChain\nsession-end (verifyOnSessionEnd)\n+ prov --verify (offline)\n+ prov --verify --session <id>\n  (scoped, per-row Merkle\n  inclusion proofs)"

writers.hooks -> jsonl: "every decision,\n43 entry types\n(incl. maintenance / observe /\nwould-block / suspended / session-summary /\ngenerate-draft / marker-retry /\nchain-epoch / chain-verify)\nno/unknown sessionID → shared"
writers.hooks -> sessions: "entry with a resolvable\nparent sessionID\n(sinkFor → parent's file)"
writers.hooks -> trace: "trace:true only"
writers.hooks -> approval: "bound APPROVE credits\n(fail-open; unbound records nothing)"
approval -> ledger: "at ledger creation:\nload, last-wins per (project, plan),\nevict to cap"
jsonl -> replay: "at ledger creation:\nreplayTailLines (2000) newest,\nwalking all retained\ngenerations, early stop\nonce the bound is met"
sessions -> replay: "same walk per file,\nmerged ts-ordered"
replay -> ledger
ledger -> enforce
jsonl -> cli
jsonl -> summary: "readJournalEntries\n(current file only — rotation\nstraddles undercount visibly)"
summary: "countSessionActivity\n→ session-summary entry\n(+ toast when the host\noffers tui.toast)"
writers.hooks -> chain: "task-complete + session-end triggers:\nappend chained rows,\ncommit epoch on cadence"
chain -> epoch: "every epochEntries rows"
chain -> jsonl: "rows carry seq/prevHash/hash"
epoch -> sinks: "publish epoch ref\n(fire-and-forget on task-complete,\nawaited before the session-end\nverify, fail-open)"
sinks -> anchors: "session-state sink appends"
jsonl -> verify: "fold families across\ngenerations, re-derive roots"
anchors -> verify: "verify refs against sinks"
verify -> sinks: "session idle: anchorAsync\n(session-end) publishes first,\nthen the verify runs"