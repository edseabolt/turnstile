direction: right

session: "session.hook ×3 (hooks-session.ts)" {
  prompt: "prompt"
  generate: "generate"
  compaction: "compaction"
}

admit: "admitPrompt (hooks-core.ts):\ndedupe by message id ▸ markParent ▸ resetState\n(+continuation carry) ▸ capture\nUSER WAIVER: / PLAN APPROVED:"

clamp: "clamp temperature:\nreviewer/plan-reviewer → 0,\nexecutor/test-runner/debugger ≤ 0.2"

preserve: "append 'preserve verbatim'\n+ gate-state snapshot\n(live ledger; de-tokenized)"

permission: "permission.hook('evaluate') (hooks-permission.ts)\nnever blocks, forces 'ask'" {
  plan-arm: "action == task\nand plan gate red?"
  landing-arm: "action == bash/shell\npush without approve?\n(empty-diff exempt if proved)"
  handson-arm: "action == write/edit\nlive pendingHandsOnAsk latch?\n(inert on handsOnRelease /\nexecutor waiver or suspension)"
}

tool: "tool.hook (hooks-tool.ts)" {
  before: "execute.before\n(all gating lives here)"
  after: "execute.after\n(observation only; first surfaces config\nwarnings once per load → type:\"config\",\nnear-miss diagnostics → type:\"marker\")"
}

before-task: "task/subagent: dispatch budget ▸ per-leg caps ▸\nonce-grant short-circuit ▸ reviewer gate ▸ plan-gate ▸\ndecomposition ▸ dispatch counted + journaled at guard exit"
before-read: "read: parent-keyed horizon — check +\nincrement atomically; warn @8 block @15"
before-bash: "bash/shell: denylist ▸ commit lint ▸ landing gate"
before-write: "write/edit: path denylist ▸ hands-on gate\n(parent sessions only — a registered pipeline\nchild's write/edit never gates; released by\nwaiver/always/once-grant; first block throws,\nrepeat arms the ask)"

after-task: "task delivery: classifyDelivery ▸\nparseMarkers(task-result) ▸\nattributePlanVerdict ▸ ensemble-gated\nhasReviewApprove ▸ PIPELINE status append\n(per delivery) ▸ policy prepend (once)"
after-read: "read: correct the read-counter charge\nwhen the read produced no output (before\nguard charged it)"
after-bash: "bash exit-0: evidence.observe →\npromote unverifiedPass → GATE PASS"

eventloop: "event.subscribe stream loop (hooks-events.ts,\nthrow-only 5-restart budget)" {
  created: "session.created → child→parent edge;\nroot seeds per-session dir cache"
  text: "message.part.updated /\nsession.text.ended / .delta\n(Δ chunk reassembled in a per-session\nwindow) → parseMarkers"
  permbook: "permission.asked / replied\n→ plan, landing & hands-on\nask bookkeeping"
  inbox: "session.inbox.enqueued\n→ prompt admission (≥ 2.0.29)"
  idle: "session.idle → session-end summary\n(one recap line per session; journaled\ntype:\"session-summary\" + best-effort toast)"
  errors: "session.error → telemetry"
}

session.prompt -> admit
session.generate -> clamp
session.compaction -> preserve
tool.before -> before-task
tool.before -> before-read
tool.before -> before-bash
tool.before -> before-write
tool.after -> after-task
tool.after -> after-read
tool.after -> after-bash
eventloop.inbox -> admit: "same admission path"
permission.plan-arm -> admit: "reply 'always' → PLAN APPROVED state"
permission.landing-arm -> tool.before-bash: "consume pendingOnceGrant.landing"
permission.handson-arm -> tool.before-write: "consume pendingOnceGrant.handsOn\n(one edit)"