{
  "name": "turnstile",
  "version": "0.1.0",
  "description": "OpenCode plugin that mechanically enforces agent pipeline gates (planner → executor → test-runner → reviewer)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "turnstile.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:markers": "node scripts/check-markers.mjs",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "install": "node scripts/install.mjs",
    "install:copy": "node scripts/install.mjs --copy",
    "install:check": "node scripts/install.mjs --check",
    "install:agents": "node scripts/install-agents.mjs",
    "ci:host": "npm run lint && npm run format:check && npm run typecheck && npm run check:markers && npm test",
    "ci": "npm run ci:host && npm run install:check"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1"
  }
}
