{
  "name": "opencode-turnstile",
  "version": "0.3.0",
  "description": "OpenCode plugin that mechanically enforces an agent pipeline (planner → plan-reviewer → executor → test-runner → reviewer) for OpenCode",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opencode-turnstile": "bin/cli.mjs"
  },
  "files": [
    "turnstile.ts",
    "src",
    "schemas",
    "scripts",
    "bin",
    "install.json",
    "skills",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:markers": "node scripts/check-markers.mjs",
    "test": "node --test --experimental-strip-types --experimental-test-isolation=none --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include='**/src/**' --test-coverage-include='**/turnstile.ts' tests/*.test.ts",
    "init": "node scripts/install.mjs",
    "init:copy": "node scripts/install.mjs --copy",
    "init:check": "node scripts/install.mjs --check",
    "install:copy": "node scripts/install.mjs --copy",
    "install:check": "node scripts/install.mjs --check",
    "pack:dry": "npm pack --dry-run",
    "ci:host": "npm run lint && npm run format:check && npm run typecheck && npm run check:markers && npm test",
    "ci": "npm run ci:host",
    "ci:installed": "npm run install:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edseabolt/turnstile.git"
  },
  "bugs": {
    "url": "https://github.com/edseabolt/turnstile/issues"
  },
  "homepage": "https://github.com/edseabolt/turnstile#readme",
  "engines": {
    "node": ">=22.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1"
  }
}
