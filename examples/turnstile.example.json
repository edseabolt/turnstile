{
  "journalMaxBytes": 5242880,
  "journalMaxGenerations": 5,
  "journalArchiveGenerations": 5,
  "journalRotateEveryEntries": 512,
  "journalPerSession": true,
  "replayTailLines": 2000,
  "maxReviewerRounds": 2,
  "maxPlannerRounds": 3,
  "maxPlanReviewerRounds": 3,
  "maxTestRunnerRounds": 4,
  "maxRequirementsRounds": 2,
  "maxTotalDispatches": 16,
  "maxSessions": 64,
  "agentMarkerRetry": 1,
  "readWarn": 8,
  "readBlock": 15,
  "observeSessions": 0,
  "waiverMarker": "USER WAIVER:",
  "approvalMarker": "PLAN APPROVED:",
  "plansDir": ".opencode/plans",
  "trace": true,
  "sessionSummary": "quiet",
  "tokenUsage": "summary",
  "continuationCarry": true,
  "escalation": "block",
  "suspendMarker": "TURNSTILE OFF:",
  "resumeMarker": "TURNSTILE ON:",
  "taskDoneMarker": "TASK DONE:",
  "allowSuspend": true,
  "intentNudge": true,
  "alwaysEnforce": false,
  "planImpactStrict": false,
  "planUserReview": false,
  "requirementsPhase": false,
  "planReviewAcceptMarker": "PLAN REVIEWED:",
  "planReviewRejectMarker": "PLAN REJECTED:",
  "questionTimeoutMinutes": 0,
  "questionTimeoutAction": "hold",
  "questionCancelMarker": "QUESTION CANCELLED:",
  "agents": {
    "planner": "planner",
    "reviewer": "reviewer",
    "planReviewer": "plan-reviewer",
    "executor": "executor",
    "testRunner": "test-runner",
    "debugger": "debugger",
    "requirements": "requirements",
    "bareOutput": []
  },
  "gateMarker": "^\\s*[`>#*\\s]*GATE: (PASS|FAIL) tests=\\d+ passed=\\d+ failed=\\d+",
  "verdictMarker": "^\\s*[`>#*\\s]*VERDICT: (APPROVE|BLOCK) crit=\\d+ high=\\d+ med=\\d+ low=\\d+",
  "gateEvidence": "enforce",
  "requireTestOverlap": false,
  "testOverlapExempt": [],
  "testOverlapTestFilePattern": [
    "\\.test\\.[cm]?[jt]sx?$",
    "\\.spec\\.[cm]?[jt]sx?$",
    "(^|/)tests?/",
    "__tests__/",
    "(^|/)test_[^/]*\\.py$",
    "(^|/)[^/]*_test\\.py$",
    "(^|/)[^/]*_test\\.go$",
    "(^|/)[^/]*_test\\.rs$",
    "[^/]*Test\\.java$",
    "[^/]*Tests?\\.kt$",
    "src/test/",
    "(^|/)[^/]*_spec\\.rb$",
    "(^|/)test/",
    "(^|/)test_[^/]*\\.c(c|pp|xx|\\+\\+)?$",
    "(^|/)[^/]*_test\\.c(c|pp|xx|\\+\\+)?$"
  ],
  "reviewEnsemble": "enforce",
  "evidencePattern": "\\b(npm\\s+(run\\s+)?test|npm\\s+run\\s+ci|pnpm\\s+test|yarn\\s+test|bun\\s+test|deno\\s+test|node\\s+(?:--[\\w=-]+\\s+)*--test|pytest|make\\s+test(\\s|$)|go\\s+test|cargo\\s+test)\\b",
  "toolPolicy": {
    "bashDeny": [],
    "pathDeny": [],
    "observeSessionMove": true,
    "bashWriteGate": true
  },
  "gitGates": {
    "commitMessages": true,
    "commitFormat": "(?:feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(?:\\([^)]*\\))?(?:[!]:?|:) [^\\r\\n]{1,72}(?:(?:\\r?\\n){1,2}[^\\r\\n]*)?",
    "landingGate": true,
    "emptyDiffExempt": true,
    "commitRetryThreshold": 3,
    "commitRetryWindowMs": 60000
  },
  "decisionLedger": {
    "enabled": true
  },
  "tamperEvidence": {
    "enabled": false,
    "anchor": "session-state",
    "epochEntries": 512,
    "verifyOnSessionEnd": false
  },
  "secrets": {
    "patterns": [],
    "writeGuard": "advise",
    "entropy": false
  }
}
